    {
      "id": "-kA_YpYvFYNu9im5nJnMA",
      "type": "text",
      "x": 244.8000030517578,
      "y": 245.41876220703125,
      "width": 852.8793334960938,
      "height": 2175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
